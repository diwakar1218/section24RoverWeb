# Edit api_base_url.json to choose local or server. Keep this empty for same-origin requests.
NEXT_PUBLIC_API_URL=
# Optional process overrides: SURVEY_API_MODE=local|server and SURVEY_API_UPSTREAM=<API root>.
# Explicit development fixture mode. API mode is the default.
NEXT_PUBLIC_DEMO_MODE=false
# Use auto only after WebSocket upgrades work through every hosting proxy.
NEXT_PUBLIC_SIGNALR_TRANSPORT=longPolling
# Optional: map stays disabled until a Google Maps browser key is configured.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Use your Google Cloud map ID for production. DEMO_MAP_ID is for development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
